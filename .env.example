# CivicFlow AI - Environment Variables Template
# Google AI Agent Builder Series 2026 National Finale

# 1. Google AI Studio / Gemini API Key (Required for Multimodal Vision AI)
GEMINI_API_KEY=

# 2. Security & JWT Authentication Secret
JWT_SECRET=civicflow_super_secret_jwt_key_2026

# 3. Database Connection URL (SQLite default or PostgreSQL)
DATABASE_URL=sqlite:///./backend/civicflow.db

# 4. ChromaDB Vector Store Persistence Path
CHROMA_PATH=./backend/chroma_db

# 5. SMTP Email Configuration (Optional - for real email notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 6. API Configuration
PROJECT_NAME=CivicFlow AI
VERSION=1.0.0
API_V1_STR=/api/v1
